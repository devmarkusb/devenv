{
  "problemMatcher": [
    {
      "owner": "clang-tidy",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+): (note|warning|error): (.+?)(?:\\s*\\[(.+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      ]
    }
  ]
}
